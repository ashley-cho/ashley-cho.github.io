---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---
<Base title="Notes">
  {posts.length === 0 && (
    <p style="color:var(--fg-muted)">Nothing published yet.</p>
  )}
  <ul class="entry-list">
    {posts.map(p => (
      <li class="entry">
        <a class="entry-title" href={p.data.url ?? `/writing/${p.id}/`}>{p.data.title}</a>
        <span class="entry-date">{fmt(p.data.date)}</span>
      </li>
    ))}
  </ul>
</Base>
