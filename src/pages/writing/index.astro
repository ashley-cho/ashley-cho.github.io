---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const meta = (d) => [fmt(d.date), d.series].filter(Boolean).join(' · ');
---
<Base title="Notes">
  <h1>Notes</h1>
  {posts.length === 0 && (
    <p style="color:var(--fg-muted)">Nothing published yet.</p>
  )}
  <ul class="entry-list">
    {posts.map(p => (
      <li class="entry">
        <a class="entry-title" href={p.data.url ?? `/writing/${p.id}/`}>{p.data.title}</a>
        <div class="entry-date">
          <span class="entry-field">{p.data.field}</span> · {meta(p.data)}
        </div>
        {p.data.description && <p>{p.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
