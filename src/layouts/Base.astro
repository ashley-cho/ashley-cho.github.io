---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

const { title, description = 'Ashley Cho — notes, essays, and things I got curious about.' } = Astro.props;
const full = title ? `${title} — Ashley Cho` : 'Ashley Cho';
const path = Astro.url.pathname;
const nav = [
  { href: '/writing/',     label: 'Writing' },
  { href: '/datacenters/', label: 'Data centers' },
  { href: '/about/',       label: 'About' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="Ashley Cho" href="/rss.xml" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛰️</text></svg>" />
</head>
<body>
  <header class="site-head">
    <div class="wrap">
      <nav>
        <span class="brand"><a href="/">Ashley Cho</a></span>
        {nav.map(i => (
          <a href={i.href} style={path.startsWith(i.href) ? 'color:var(--fg)' : ''}>{i.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap">
      <slot />
    </div>
  </main>

  <footer class="site-foot">
    <div class="wrap" style="display:flex;gap:1rem;flex-wrap:wrap;width:100%">
      <span>© {new Date().getFullYear()} Ashley Cho</span>
      <span style="margin-left:auto"><a href="/rss.xml">RSS</a></span>
    </div>
  </footer>
</body>
</html>
