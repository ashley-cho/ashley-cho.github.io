#!/usr/bin/env bash
# ship "commit message"
#
# Tests, commits, pushes the branch, prints a PR link.
# A failing build never leaves the laptop, and never commits to main.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
msg="${1:?usage: ./ship \"commit message\"}"

if [ -z "$(git status --porcelain)" ]; then
  echo "Nothing to commit -- working tree is clean."
  exit 1
fi

# Tests first, so a failure leaves you exactly where you were.
npm test

if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
  new="change-$(date +%m%d-%H%M)"
  echo "On main; branching to $new"
  git switch -c "$new"
fi

git add -A
git commit -m "$msg"

branch="$(git rev-parse --abbrev-ref HEAD)"
git push -u origin "$branch"

# Works for https and ssh remotes alike
url="$(git remote get-url origin)"; url="${url%.git}"
url="${url/git@github.com:/https://github.com/}"
printf '\nPushed %s. Open the PR:\n  %s/compare/%s?expand=1\n' "$branch" "$url" "$branch"
